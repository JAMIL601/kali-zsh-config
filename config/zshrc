# ==========================================================
# Kali Zsh Config - Main Loader
# ==========================================================

# The installer defines this variable.
# Do not try to calculate the repository path from $0.

if [[ -z "$KALI_ZSH_CONFIG_DIR" ]]; then
    print -u2 "Kali Zsh Config: KALI_ZSH_CONFIG_DIR is not set."
    return 1
fi

if [[ ! -d "$KALI_ZSH_CONFIG_DIR" ]]; then
    print -u2 "Kali Zsh Config: repository not found:"
    print -u2 "  $KALI_ZSH_CONFIG_DIR"
    return 1
fi

# Core configuration
source "$KALI_ZSH_CONFIG_DIR/config/options.zsh"
source "$KALI_ZSH_CONFIG_DIR/config/aliases.zsh"
source "$KALI_ZSH_CONFIG_DIR/config/completion.zsh"

# Widgets
if [[ -f "$KALI_ZSH_CONFIG_DIR/widgets/filesystem-preview.zsh" ]]; then
    source "$KALI_ZSH_CONFIG_DIR/widgets/filesystem-preview.zsh"
fi

if [[ -f "$KALI_ZSH_CONFIG_DIR/widgets/tool-completion.zsh" ]]; then
    source "$KALI_ZSH_CONFIG_DIR/widgets/tool-completion.zsh"
fi
